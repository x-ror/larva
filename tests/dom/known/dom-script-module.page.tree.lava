# exit 0
| <!DOCTYPE html>
| <html>
|   <head>
|     <title>
|       "module scripts"
|     "
"
|     <script>
|       "
var order = [];
function name(n) {
  return n === null ? 'null' : n === document ? 'document' : n === window ? 'window' : n.nodeName + (n.id ? '#' + n.id : '');
}
document.addEventListener('DOMContentLoaded', function () {
  order.push('DOMContentLoaded');
});
"
|     "
"
|     <script>
|       id="m1"
|       type="module"
|       "
order.push('inline module current=' + name(document.currentScript) + ' ' + document.readyState + ' this=' + typeof this);
"
|     "
"
|     <script>
|       id="m2"
|       type="module"
|       src="dom-script-module.page.1.js"
|     "
"
|     <script>
|       id="fallback"
|       nomodule=""
|       "order.push('nomodule (never)');"
|     "
"
|     <script>
|       id="classic"
|       "order.push('classic ' + document.readyState);"
|     "
"
|   "
"
|   <body>
|     "
"
|     <pre>
|       id="log"
|       "classic loading
DOMContentLoaded
"
|     "
"
|     <script>
|       "
window.addEventListener('load', function () {
  document.getElementById('log').textContent = order.join('\n') + '\n';
});
"
|     "


