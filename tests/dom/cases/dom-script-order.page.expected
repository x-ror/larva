#serialize
<!DOCTYPE html><html><head><title>script order</title>
<script>
var order = [];
order.push('head:' + (document.body === null) + ':' + document.getElementsByTagName('script').length);
</script>
</head>
<body>
<p id="before">changed by script 1</p>
<script>
order.push('body1:' + (document.getElementById('before') !== null) + ':' + (document.getElementById('after') === null));
var me = document.getElementsByTagName('script');
order.push('self:' + me.length + ':' + (me[me.length - 1].nextSibling === null));
document.getElementById('before').textContent = 'changed by script 1';
</script>
<p id="after">after</p>
<script type="text/plain">order.push('data block ran');</script>
<script type="">order.push('empty type');</script>
<script type="TEXT/JavaScript">order.push('mime type');</script>
<script nomodule="">order.push('nomodule ran');</script>
<script>
order.push('body2:' + document.getElementById('after').textContent);
order.push('microtask-queued');
Promise.resolve().then(function () { order.push('microtask'); });
</script>
<script>
order.push('body3');
</script>
<pre id="log">head:true:1
body1:true:true
self:2:true
empty type
mime type
body2:after
microtask-queued
microtask
body3
</pre>
<script>
document.getElementById('log').textContent = order.join('\n') + '\n';
</script>


</body></html>
