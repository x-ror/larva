function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
function chain(o) {
  var out = [];
  for (var p = Object.getPrototypeOf(o); p !== null; p = Object.getPrototypeOf(p)) out.push(p.constructor.name);
  return out.join('>');
}
log('window ' + (window === globalThis) + ' ' + (window.document === document) + ' ' + typeof window);
log('document ' + document.nodeType + ' ' + document.nodeName + ' ' + document.parentNode + ' ' + document.isConnected);
log('root ' + document.documentElement.tagName + ' ' + document.head.tagName + ' ' + document.body.tagName);
log('doctype ' + document.firstChild.nodeType + ' ' + document.firstChild.nodeName + ' ' + document.firstChild.name);
log('title ' + JSON.stringify(document.title));
document.title = 'Changed  title';
log('title set ' + JSON.stringify(document.title) + ' ' + document.querySelector('title').textContent);
log('children ' + document.children.length + ' ' + document.childElementCount + ' ' + document.firstElementChild.tagName);
log('tags ' + Object.prototype.toString.call(document) + ' ' + Object.prototype.toString.call(document.getElementById('d')) + ' ' + Object.prototype.toString.call(document.createTextNode('')) + ' ' + Object.prototype.toString.call(document.createComment('')));
log('chain div ' + chain(document.getElementById('d')));
log('chain body ' + chain(document.body));
log('chain doc ' + chain(document));
log('chain text ' + chain(document.createTextNode('x')));
log('chain comment ' + chain(document.createComment('x')));
log('chain list ' + chain(document.body.childNodes) + ' ' + chain(document.body.children));
log('chain misc ' + [document.createElement('p'), document.createElement('a'), document.createElement('span'), document.createElement('section'), document.createElement('foo'), document.createElement('my-widget')].map(function (e) { return Object.getPrototypeOf(e).constructor.name; }).join(','));
log('instanceof ' + (document.body instanceof Node) + ' ' + (document.body instanceof EventTarget) + ' ' + (document instanceof Document) + ' ' + (document.createTextNode('') instanceof CharacterData));
log('constants ' + Node.ELEMENT_NODE + ' ' + Node.TEXT_NODE + ' ' + document.body.COMMENT_NODE + ' ' + Node.DOCUMENT_NODE);
log('illegal ' + (function () { try { new Node(); } catch (e) { return e.constructor.name; } })() + ' ' + (function () { try { new HTMLDivElement(); } catch (e) { return e.constructor.name; } })());
var get = Object.getOwnPropertyDescriptor(Node.prototype, 'parentNode').get;
log('receiver ' + (function () { try { get.call({}); } catch (e) { return e.constructor.name + ': ' + e.message; } })());
log('native ' + Function.prototype.toString.call(Node.prototype.appendChild) + ' ' + Function.prototype.toString.call(get));
log('created ' + document.createElement('DIV').tagName + ' ' + document.createElement('Custom-El').localName);
var head = document.head;
var meta = head.firstChild;
log('head ' + meta.tagName + ' ' + meta.getAttribute('charset') + ' ' + document.documentElement.getAttribute('lang'));
