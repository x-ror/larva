function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
function show(v) {
  return typeof v === 'string' ? JSON.stringify(v) : String(v);
}
function attempt(label, f) {
  try {
    log(label + ' ' + show(f()));
  } catch (e) {
    log(label + ' threw ' + e.name + ': ' + e.message);
  }
}
var COMPONENTS = ['href', 'origin', 'protocol', 'username', 'password', 'host', 'hostname', 'port', 'pathname', 'search', 'hash'];
function parts(a) {
  return COMPONENTS.map(function (k) { return k + '=' + show(a[k]); }).join(' ');
}

// HTMLAnchorElement: URL resolution against <base>, and the URL decomposition.
var link = document.getElementById('link');
log('parsed ' + parts(link));
log('parsed ' + [link.rel, link.target, link.download, link.hreflang, link.type, link.referrerPolicy, link.text, String(link), link.toString()].map(show).join(' '));
var a = document.createElement('a');
log('no href ' + parts(a));
a.setAttribute('href', '');
log('empty href ' + parts(a));
a.setAttribute('href', 'http://[bad');
log('bad href ' + parts(a));
a.protocol = 'https';
a.hash = 'x';
log('setters on bad href ' + show(a.getAttribute('href')));
a.href = 'HTTP://u:p@Ex.com:80/p/a?x=1#h';
log('absolute ' + parts(a) + ' attr=' + show(a.getAttribute('href')));
a.protocol = 'https:';
a.username = 'user';
a.password = '';
a.port = '8080';
a.hostname = 'h.org';
a.pathname = 'q/r';
a.search = 'k=v';
a.hash = '#zz';
log('after setters ' + show(a.getAttribute('href')));
a.host = 'other.net:99';
log('host setter ' + show(a.getAttribute('href')));
a.setAttribute('href', 'mailto:x@y');
log('mailto ' + parts(a));
a.host = 'ignored';
log('mailto host setter ' + show(a.getAttribute('href')));
a.setAttribute('href', 'blob:https://ex.com/uuid');
log('blob origin ' + show(a.origin));
a.removeAttribute('href');
a.hash = 'x';
log('removed href ' + show(a.getAttribute('href')) + ' ' + show(a.protocol));
a.text = 'T<b>';
log('text ' + show(a.innerHTML) + ' ' + show(a.text));
a.referrerPolicy = 'bogus';
log('referrerPolicy ' + show(a.getAttribute('referrerpolicy')) + ' ' + show(a.referrerPolicy));
['NO-REFERRER', 'unsafe-url', 'strict-origin-when-cross-origin', '', 'origin '].forEach(function (v) {
  a.setAttribute('referrerpolicy', v);
  log('referrerpolicy ' + show(v) + ' -> ' + show(a.referrerPolicy));
});
a.href = 'a\uD800b';
log('lone surrogate ' + show(a.getAttribute('href')));

// HTMLImageElement.
var img = document.createElement('img');
log('img defaults ' + [img.alt, img.src, img.srcset, img.sizes, img.crossOrigin, img.useMap, img.isMap, img.width, img.height, img.referrerPolicy, img.decoding, img.fetchPriority, img.loading, img.name, img.lowsrc, img.align, img.hspace, img.vspace, img.longDesc, img.border].map(show).join(' '));
img.setAttribute('width', '100');
img.setAttribute('height', '50px');
img.setAttribute('hspace', '-3');
img.setAttribute('vspace', '2147483648');
log('img dims ' + img.width + ' ' + img.height + ' ' + img.hspace + ' ' + img.vspace);
[-1, 3000000000, 2147483647, 2147483648, '12.7', NaN, 4294967296].forEach(function (v) {
  img.width = v;
  log('img width = ' + show(v) + ' -> ' + show(img.getAttribute('width')));
});
img.src = 'a b.png';
img.lowsrc = '/low.png';
img.longDesc = 'https://other.org/d';
log('img urls ' + [img.src, img.getAttribute('src'), img.lowsrc, img.longDesc].map(show).join(' '));
img.setAttribute('src', 'http://[bad');
log('img bad src ' + show(img.src));
['bogus', '', 'USE-CREDENTIALS', 'anonymous'].forEach(function (v) {
  img.setAttribute('crossorigin', v);
  log('crossorigin ' + show(v) + ' -> ' + show(img.crossOrigin));
});
img.crossOrigin = null;
log('crossOrigin = null ' + img.hasAttribute('crossorigin') + ' ' + show(img.crossOrigin));
img.crossOrigin = 'x';
img.crossOrigin = undefined;
log('crossOrigin = undefined ' + show(img.getAttribute('crossorigin')));
[['loading', 'LAZY'], ['loading', 'eager'], ['loading', 'x'], ['decoding', 'SYNC'], ['decoding', 'x'], ['fetchpriority', 'HIGH'], ['fetchpriority', 'x']].forEach(function (pair) {
  img.setAttribute(pair[0], pair[1]);
  log(pair[0] + ' ' + show(pair[1]) + ' -> ' + show(img[pair[0] === 'fetchpriority' ? 'fetchPriority' : pair[0]]));
});
img.border = null;
img.isMap = 'no';
log('img border null ' + show(img.getAttribute('border')) + ' ismap ' + show(img.getAttribute('ismap')));

// HTMLScriptElement, and the force-async flag.
var s = document.createElement('script');
log('script defaults ' + [s.src, s.type, s.noModule, s.charset, s.async, s.defer, s.crossOrigin, s.text, s.referrerPolicy, s.fetchPriority, s.event, s.htmlFor, s.integrity].map(show).join(' '));
s.async = false;
log('async = false ' + s.async + ' ' + s.hasAttribute('async'));
s.async = true;
log('async = true ' + s.async + ' ' + show(s.getAttribute('async')));
var s2 = document.createElement('script');
s2.setAttribute('ASYNC', '');
s2.removeAttribute('async');
log('async attr added and removed ' + s2.async);
var s3 = document.createElement('script');
s3.removeAttribute('async');
log('async attr never there, removed ' + s3.async);
log('parser-inserted async ' + document.querySelector('script').async);
var frag = document.createElement('div');
frag.innerHTML = '<script><\/script>';
log('innerHTML script async ' + frag.firstChild.async);
s.appendChild(document.createTextNode('a'));
var b = document.createElement('b');
b.textContent = 'B';
s.appendChild(b);
s.appendChild(document.createComment('c'));
s.appendChild(document.createTextNode('d'));
log('script text ' + show(s.text) + ' ' + show(s.textContent));
s.text = 'zz';
log('script text set ' + s.childNodes.length + ' ' + show(s.innerHTML));
s.htmlFor = 'w';
s.noModule = true;
s.src = 'js/app.js';
log('script attrs ' + show(s.getAttribute('for')) + ' ' + show(s.getAttribute('nomodule')) + ' ' + show(s.src));

// HTMLLinkElement.
var l = document.createElement('link');
log('link defaults ' + [l.href, l.rel, l.as, l.media, l.hreflang, l.type, l.crossOrigin, l.disabled, l.integrity, l.referrerPolicy, String(l.sizes), l.fetchPriority, l.imageSrcset, l.imageSizes].map(show).join(' '));
['fetch', 'SCRIPT', 'style', 'font', 'image', 'track', 'audio', 'document', 'json', 'x'].forEach(function (v) {
  l.setAttribute('as', v);
  log('as ' + show(v) + ' -> ' + show(l.as));
});
l.href = 's.css';
l.disabled = true;
l.imageSrcset = 'a.png 1x';
log('link set ' + show(l.href) + ' ' + show(l.getAttribute('disabled')) + ' ' + show(l.getAttribute('imagesrcset')));

// HTMLInputElement basics.
var i = document.createElement('input');
log('input defaults ' + [i.type, i.name, i.defaultValue, i.placeholder, i.disabled, i.required, i.defaultChecked, i.readOnly, i.multiple, i.src].map(show).join(' '));
['EMAIL', 'bogus', 'datetime', 'datetime-local', 'checkbox', ''].forEach(function (v) {
  i.setAttribute('type', v);
  log('type ' + show(v) + ' -> ' + show(i.type));
});
i.type = 'Number';
i.defaultValue = 'dv';
i.defaultChecked = true;
i.readOnly = 1;
i.placeholder = 'p';
log('input set ' + [i.getAttribute('type'), i.getAttribute('value'), i.getAttribute('checked'), i.getAttribute('readonly'), i.getAttribute('placeholder')].map(show).join(' '));

// HTMLFormElement.
var form = document.getElementById('form');
log('form parsed ' + [form.action, form.method, form.enctype, form.encoding, form.acceptCharset, form.noValidate, form.autocomplete].map(show).join(' '));
var f = document.createElement('form');
log('form defaults ' + [f.method, f.enctype, f.target, f.name, f.autocomplete, f.noValidate, f.action === location.href].map(show).join(' '));
f.setAttribute('action', '');
log('empty action is the document URL ' + (f.action === location.href));
f.method = 'bogus';
log('method bogus ' + show(f.method) + ' ' + show(f.getAttribute('method')));
f.setAttribute('method', 'Dialog');
log('method Dialog ' + show(f.method));
f.encoding = 'multipart/FORM-data';
log('encoding ' + show(f.enctype) + ' ' + show(f.getAttribute('enctype')));
f.setAttribute('autocomplete', 'OFF');
log('autocomplete OFF ' + show(f.autocomplete));
f.setAttribute('autocomplete', 'x');
log('autocomplete x ' + show(f.autocomplete));
f.action = '/post';
log('action ' + show(f.action));

// HTMLMetaElement.
var meta = document.querySelector('meta');
log('meta ' + [meta.name, meta.httpEquiv, meta.content, meta.media, meta.scheme].map(show).join(' '));
meta.httpEquiv = 'refresh';
log('meta http-equiv ' + show(meta.getAttribute('http-equiv')));

// HTMLIFrameElement.
var fr = document.createElement('iframe');
log('iframe defaults ' + [fr.src, fr.srcdoc, fr.name, fr.allowFullscreen, fr.width, fr.height, fr.referrerPolicy, fr.allow, fr.loading, fr.frameBorder].map(show).join(' '));
