function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
function d(n) {
  if (n === null) return 'null';
  if (n === undefined) return 'undefined';
  switch (n.nodeType) {
    case 1: return n.nodeName.toLowerCase() + (n.id ? '#' + n.id : '');
    case 2: return '@' + n.name + '=' + JSON.stringify(n.value);
    case 3: return 'text' + JSON.stringify(n.data);
    case 9: return 'document';
  }
  return '?' + n.nodeType;
}
function attempt(label, f) {
  try {
    log(label + ' ' + f());
  } catch (e) {
    log(label + ' THREW ' + e.name + ' ' + e.constructor.name + ': ' + e.message);
  }
}
var t = document.getElementById('t');
var props = ['numberValue', 'stringValue', 'booleanValue', 'singleNodeValue', 'snapshotLength', 'invalidIteratorState'];
function dump(label, r) {
  var out = [label, 'type=' + r.resultType];
  for (var i = 0; i < props.length; i++) {
    try {
      var v = r[props[i]];
      out.push(props[i] + '=' + (props[i] === 'singleNodeValue' ? d(v) : String(v)));
    } catch (e) {
      out.push(props[i] + '!' + e.name);
    }
  }
  log(out.join(' '));
}

// Constants and shape.
var names = ['ANY_TYPE', 'NUMBER_TYPE', 'STRING_TYPE', 'BOOLEAN_TYPE', 'UNORDERED_NODE_ITERATOR_TYPE', 'ORDERED_NODE_ITERATOR_TYPE', 'UNORDERED_NODE_SNAPSHOT_TYPE', 'ORDERED_NODE_SNAPSHOT_TYPE', 'ANY_UNORDERED_NODE_TYPE', 'FIRST_ORDERED_NODE_TYPE'];
log('constants ' + names.map(function (n) { return XPathResult[n] + '/' + XPathResult.prototype[n]; }).join(' '));
log('types ' + typeof XPathResult + ' ' + typeof XPathEvaluator + ' ' + typeof XPathExpression);
log('proto ' + Object.getOwnPropertyNames(XPathResult.prototype).join(','));
log('proto ' + Object.getOwnPropertyNames(XPathExpression.prototype).join(','));
log('proto ' + Object.getOwnPropertyNames(XPathEvaluator.prototype).join(','));
log('lengths ' + document.evaluate.length + ' ' + document.createExpression.length + ' ' + document.createNSResolver.length + ' ' + XPathExpression.prototype.evaluate.length);
attempt('new XPathResult', function () { return new XPathResult(); });
attempt('new XPathExpression', function () { return new XPathExpression(); });
attempt('call XPathEvaluator', function () { return XPathEvaluator(); });

// Each result type.
dump('any-number', document.evaluate('count(//p)', t, null, 0, null));
dump('any-string', document.evaluate('string(p)', t, null, XPathResult.ANY_TYPE, null));
dump('any-boolean', document.evaluate('1 = 1', t, null, 0, null));
dump('any-nodes', document.evaluate('p', t, null, 0, null));
dump('number', document.evaluate('p', t, null, 1, null));
dump('string', document.evaluate('p', t, null, 2, null));
dump('boolean', document.evaluate('p', t, null, 3, null));
dump('unordered-iter', document.evaluate('p', t, null, 4, null));
dump('ordered-iter', document.evaluate('p', t, null, 5, null));
dump('unordered-snap', document.evaluate('p', t, null, 6, null));
dump('ordered-snap', document.evaluate('p', t, null, 7, null));
dump('any-unordered', document.evaluate('p', t, null, 8, null));
dump('first-ordered', document.evaluate('p', t, null, 9, null));
dump('first-none', document.evaluate('nothing', t, null, 9, null));
attempt('number-as-iter', function () { return document.evaluate('1', t, null, 4, null); });
attempt('string-as-snap', function () { return document.evaluate('"x"', t, null, 7, null); });
attempt('bool-as-first', function () { return document.evaluate('true()', t, null, 9, null); });
attempt('bad-type', function () { return d(document.evaluate('p', t, null, 42, null).singleNodeValue); });
attempt('neg-type', function () { return document.evaluate('p', t, null, -1, null).resultType; });
attempt('string-type', function () { return document.evaluate('p', t, null, '7', null).snapshotLength; });

// Iteration.
var it = document.evaluate('//p', document, null, 5, null);
var seen = [];
for (var n = it.iterateNext(); n; n = it.iterateNext()) seen.push(d(n));
log('iterate ' + seen.join(' ') + ' then ' + it.iterateNext() + ' invalid=' + it.invalidIteratorState);
var snapR = document.evaluate('//p', document, null, 7, null);
log('snapshot ' + snapR.snapshotLength + ' ' + d(snapR.snapshotItem(0)) + ' ' + d(snapR.snapshotItem(9)) + ' ' + d(snapR.snapshotItem(-1)));
attempt('snapshotItem-noargs', function () { return snapR.snapshotItem(); });
attempt('iterate-on-snapshot', function () { return snapR.iterateNext(); });
attempt('snapshotItem-on-iter', function () { return it.snapshotItem(0); });

// Mutation during iteration.
var it2 = document.evaluate('//p', document, null, 4, null);
var first = d(it2.iterateNext());
t.appendChild(document.createElement('span'));
var inv = it2.invalidIteratorState;
attempt('mutated ' + first + ' invalid=' + inv, function () { return it2.iterateNext(); });
var it3 = document.evaluate('//p', document, null, 4, null);
document.getElementById('a').setAttribute('data-y', '1');
var inv3 = it3.invalidIteratorState;
attempt('attr-mutated invalid=' + inv3, function () { return d(it3.iterateNext()); });
var it4 = document.evaluate('//p', document, null, 4, null);
document.getElementById('a').firstChild.data = 'AA';
var inv4 = it4.invalidIteratorState;
attempt('data-mutated invalid=' + inv4, function () { return d(it4.iterateNext()); });
var snap5 = document.evaluate('//p', document, null, 7, null);
t.appendChild(document.createElement('span'));
log('snapshot-after-mutation ' + snap5.snapshotLength + ' ' + d(snap5.snapshotItem(0)));

// Result reuse, evaluator objects, resolver.
var reuse = document.evaluate('p', t, null, 7, null);
var again = document.evaluate('count(p)', t, null, 0, reuse);
log('reuse ' + (again === reuse) + ' ' + again.resultType);
var ev = new XPathEvaluator();
log('evaluator ' + Object.prototype.toString.call(ev) + ' ' + ev.evaluate('count(//p)', document, null, 1, null).numberValue);
var expr = document.createExpression('p[1]');
log('expression ' + Object.prototype.toString.call(expr) + ' ' + d(expr.evaluate(t, 9, null).singleNodeValue) + ' ' + d(expr.evaluate(document.getElementById('c').firstChild.lastChild, 9).singleNodeValue));
log('expression-default ' + expr.evaluate(t).resultType);
var expr2 = ev.createExpression('count(*)', null);
log('evaluator-expression ' + expr2.evaluate(t).numberValue);
log('resolver ' + (document.createNSResolver(t) === t) + ' ' + (ev.createNSResolver(document) === document));
attempt('resolver-bad', function () { return document.createNSResolver(5); });
log('defaults ' + document.evaluate('count(*)', t).numberValue);
attempt('no-args', function () { return document.evaluate(); });
attempt('one-arg', function () { return document.evaluate('1'); });
attempt('bad-context', function () { return document.evaluate('1', {}, null, 0, null); });
attempt('null-context', function () { return document.evaluate('1', null, null, 0, null); });
attempt('bad-resolver', function () { return document.evaluate('1', t, 5, 0, null); });
attempt('bad-result', function () { return document.evaluate('1', t, null, 0, {}).numberValue; });
attempt('syntax', function () { return document.evaluate('//[', t, null, 0, null); });
attempt('syntax-create', function () { return document.createExpression('1 +'); });
attempt('syntax-evaluator', function () { return ev.evaluate('))', t, null, 0, null); });
attempt('prefix-no-resolver', function () { return document.evaluate('//x:p', t, null, 0, null); });
attempt('prefix-resolver-fn', function () { return document.evaluate('//x:p', t, function () { return 'http://www.w3.org/1999/xhtml'; }, 7, null).snapshotLength; });
attempt('prefix-resolver-obj', function () { return document.evaluate('//x:p', t, { lookupNamespaceURI: function (p) { return p === 'x' ? 'http://www.w3.org/1999/xhtml' : null; } }, 7, null).snapshotLength; });
attempt('prefix-resolver-null', function () { return document.evaluate('//x:p', t, function () { return null; }, 7, null).snapshotLength; });
attempt('expr-coerce', function () { return document.evaluate({ toString: function () { return 'count(p)'; } }, t, null, 0, null).numberValue; });
attempt('expr-bad-receiver', function () { return XPathExpression.prototype.evaluate.call({}, t); });
attempt('result-bad-receiver', function () { return Object.getOwnPropertyDescriptor(XPathResult.prototype, 'resultType').get.call({}); });
attempt('expr-bad-context', function () { return expr.evaluate(5); });
attempt('text-context', function () { return document.evaluate('string(.)', document.getElementById('a').firstChild, null, 2, null).stringValue; });
attempt('detached-context', function () { var x = document.createElement('div'); x.innerHTML = '<b>q</b><b>r</b>'; return document.evaluate('count(b) + count(/)', x, null, 1, null).numberValue + ' ' + d(document.evaluate('/', x, null, 9, null).singleNodeValue); });

// HTML names.
function snap(expr) {
  try {
    var r = document.evaluate(expr, t, null, 7, null);
    var o = [];
    for (var i = 0; i < r.snapshotLength; i++) o.push(d(r.snapshotItem(i)));
    log(expr + ' => [' + o.join(' ') + ']');
  } catch (e) {
    log(expr + ' THREW ' + e.name + ': ' + e.message);
  }
}
snap('//P');
snap('//p');
snap('//Div');
snap('//svg');
snap('//circle');
snap('//foreignObject');
snap('//*[local-name()="svg"]');
snap('//*[local-name()="foreignObject"]/*');
snap('//*[name()="P"]');
snap('//*[name()="p"]');
snap('//@Data-X');
snap('//@data-x');
snap('//*[@DATA-X]');
snap('//@viewBox');
snap('//@viewbox');
snap('//*[namespace-uri()="http://www.w3.org/2000/svg"]');
snap('//*[namespace-uri()="http://www.w3.org/1999/xhtml" and @id="b"]');
