// Async scripts run as soon as each is fetched, so their order among themselves and
// against the parser and DOMContentLoaded is a race: the case records only what holds
// either way, each script's own line sorted, and that all of them ran before `load`.
var lines = [];
var loads = [];
var loaded = false;
function name(n) {
  return n === null ? 'null' : n === document ? 'document' : n === window ? 'window' : n.nodeName + (n.id ? '#' + n.id : '');
}
document.addEventListener('load', function (e) {
  if (e.target !== document) loads.push('load at ' + name(e.target) + ' window loaded=' + loaded);
}, true);
document.addEventListener('error', function (e) {
  loads.push('error at ' + name(e.target) + ' window loaded=' + loaded);
}, true);
