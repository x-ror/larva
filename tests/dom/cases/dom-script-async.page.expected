#serialize
<!DOCTYPE html><html><head><title>async scripts</title>
<script>
// Async scripts run as soon as each is fetched, so their order among themselves and
// against the parser and DOMContentLoaded is a race: the case records only what holds
// either way, each script's own line sorted, and that all of them ran before `load`.
var lines = [];
var loads = [];
var loaded = false;
function name(n) {
  return n === null ? 'null' : n === document ? 'document' : n === window ? 'window' : n.nodeName + (n.id ? '#' + n.id : '');
}
document.addEventListener('load', function (e) {
  if (e.target !== document) loads.push('load at ' + name(e.target) + ' window loaded=' + loaded);
}, true);
document.addEventListener('error', function (e) {
  loads.push('error at ' + name(e.target) + ' window loaded=' + loaded);
}, true);
</script>
<script id="x1" async="" src="dom-script-async.page.1.js"></script>
<script id="x2" async="" defer="" src="dom-script-async.page.2.js"></script>
<script id="x-missing" async="" src="dom-script-async.page.missing.js"></script>
<script id="inline-async" async="">lines.push('inline async runs at once ' + document.readyState + ' current=' + name(document.currentScript));</script>
</head>
<body>
<p>body</p>
<pre id="log">async 1 current=SCRIPT#x1 window loaded=false
async 2 current=SCRIPT#x2 window loaded=false
inline async runs at once loading current=SCRIPT#inline-async
error at SCRIPT#x-missing window loaded=false
load at SCRIPT#x1 window loaded=false
load at SCRIPT#x2 window loaded=false
</pre>
<script>
window.addEventListener('load', function () {
  loaded = true;
  lines.sort();
  loads.sort();
  document.getElementById('log').textContent = lines.concat(loads).join('\n') + '\n';
});
</script>


</body></html>
