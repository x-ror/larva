  log('invalid ' + e.name + ' ' + e.constructor.name);
}
try {
  document.querySelector();
} catch (e) {
  log('missing ' + e.constructor.name);
}
var made = document.createElement('div');
made.innerHTML = '<span class="x">in</span>';
log('detached ' + made.querySelector('.x').textContent + ' ' + document.querySelector('.x'));
