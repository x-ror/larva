function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
function d(n) {
  if (n === null) return 'null';
  switch (n.nodeType) {
    case 1: return n.nodeName.toLowerCase() + (n.id ? '#' + n.id : '');
    case 2: return '@' + n.name + '=' + JSON.stringify(n.value);
    case 3: return 'text' + JSON.stringify(n.data);
    case 7: return 'pi:' + n.target + '=' + JSON.stringify(n.data);
    case 8: return 'comment:' + n.data;
    case 9: return 'document';
  }
  return '?' + n.nodeType;
}
function snap(expr, ctx) {
  try {
    var r = document.evaluate(expr, ctx || t, null, 7, null);
    var o = [];
    for (var i = 0; i < r.snapshotLength; i++) o.push(d(r.snapshotItem(i)));
    log(expr + ' => [' + o.join(' ') + ']');
  } catch (e) {
    log(expr + ' THREW ' + e.name + ': ' + e.message);
  }
}
function str(expr, ctx) {
  try {
    log(expr + ' => ' + JSON.stringify(document.evaluate(expr, ctx || t, null, 2, null).stringValue));
  } catch (e) {
    log(expr + ' THREW ' + e.name + ': ' + e.message);
  }
}
var t = document.getElementById('t');
snap('processing-instruction()');
snap('processing-instruction("php")');
snap('processing-instruction("asp")');
snap('node()');
str('name(processing-instruction())');
str('local-name(processing-instruction())');
str('string(processing-instruction())');
str('string(comment())');
str('name(comment())');
snap('a/@*');
snap('a/@href | a');
snap('(a/@href)[last()]');
var href = document.evaluate('a[1]/@href', t, null, 9, null).singleNodeValue;
snap('following::*', href);
snap('preceding::node()', href);
snap('preceding-sibling::node() | following-sibling::node()', href);
snap('self::node()', href);
snap('self::*', href);
snap('child::node()', href);
str('.', href);
str('name(.)', href);
snap('/descendant::a', href);
href.value = '/changed';
log('setter ' + document.getElementById('a1').getAttribute('href') + ' ' + href.value);
document.getElementById('a1').setAttribute('href', '/again');
log('live ' + href.value + ' ' + (href === document.evaluate('a[1]/@href', t, null, 9, null).singleNodeValue));
snap('a[@href = "/again"]');
snap('a[starts-with(@href, "/")][last()]');
snap('a[contains(., "tw")]');
snap('a[normalize-space(text()) = "one"]');
snap('//*[text() = "z"]');
snap('b/text()');
snap('b//text()[2]');
snap('b/node()[last()]');
snap('*[2]/following-sibling::*[1]');
snap('a[2]/preceding::comment()');
var r = document.evaluate('count(a)', t, null, 1, null);
var msgs = ['stringValue', 'booleanValue', 'singleNodeValue', 'snapshotLength'];
for (var i = 0; i < msgs.length; i++) {
  try {
    r[msgs[i]];
  } catch (e) {
    log(msgs[i] + ' ' + e.constructor.name + ': ' + e.message);
  }
}
try {
  document.evaluate('a', t, null, 7, null).numberValue;
} catch (e) {
  log('numberValue ' + e.constructor.name + ': ' + e.message);
}
var detached = document.createElement('ul');
detached.innerHTML = '<li id="d1">1</li><li id="d2">2</li>';
snap('li[2]', detached);
snap('id("d1 a2")', detached);
snap('/', detached);
snap('//li', detached);
var frag = document.createDocumentFragment();
frag.appendChild(document.createElement('p'));
snap('/', frag);
snap('.//p', frag);
snap('/html/body', frag.firstChild);
str('string(/)', frag);
str('string-length(normalize-space(/))', document);
log('xmlish ' + document.evaluate('count(//A) + count(//a[@HREF])', document, null, 1, null).numberValue);
