<!DOCTYPE html><html><head><title>window events</title></head>
<body>
<div id="outer"><span id="leaf">leaf</span></div>
<pre id="log">shape true function true false
bubbling true win-capture@window:1 doc-capture@document:1 leaf@leaf:2 doc-bubble@document:3 win-bubble@window:3
non-bubbling win-capture@window:1 doc-capture@document:1 leaf@leaf:2
path leaf,outer,,,document,window target=leaf
stopped win-capture@window:1 stop@window
direct true win-capture@window:2 win-bubble@window:2
unqualified window:window:2
veto false 1
custom d:4
window capture DOMContentLoaded 1
document DOMContentLoaded 2
window DOMContentLoaded true 3 document window document,window
</pre>
<script>
function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
