|     <script>
|       "
function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
function show(v) {
  return typeof v === 'string' ? JSON.stringify(v) : String(v);
}
function attempt(label, f) {
  try {
    log(label + ' ' + show(f()));
  } catch (e) {
    log(label + ' threw ' + e.name + ': ' + e.message);
  }
}

// Parsed attributes, read back through the IDL attributes.
var p = document.getElementById('para');
log('parsed ' + [p.title, p.accessKey, p.dir, p.hidden, p.tabIndex, p.lang].map(show).join(' '));

// Defaults per element.
['div', 'a', 'img', 'input', 'button', 'select', 'textarea', 'iframe', 'object', 'span', 'link', 'script', 'form', 'summary', 'embed', 'x-custom'].forEach(function (t) {
  var e = document.createElement(t);
  log('default ' + t + ' tabIndex=' + e.tabIndex + ' draggable=' + e.draggable + ' spellcheck=' + e.spellcheck + ' translate=' + e.translate + ' hidden=' + e.hidden + ' dir=' + show(e.dir) + ' title=' + show(e.title) + ' inert=' + e.inert + ' autofocus=' + e.autofocus);
});

// DOMString: any value is converted, null included.
var d = document.createElement('div');
d.title = null;
d.lang = undefined;
d.accessKey = 5;
log('strings ' + [d.getAttribute('title'), d.getAttribute('lang'), d.getAttribute('accesskey'), d.title].map(show).join(' '));
attempt('symbol title', function () { d.title = Symbol('s'); });

// long: the rules for parsing integers on read; ToInt32 on write.
['12', ' 12abc', '+7', '-0', '-5', '99999999999', '2147483647', '2147483648', '-2147483648', '-2147483649', 'x', '', '\t\n 3', '0x10', '1e3', '٣'].forEach(function (v) {
  d.setAttribute('tabindex', v);
  log('tabindex ' + show(v) + ' -> ' + d.tabIndex);
});
[-5, 4294967297, '3.9', NaN, Infinity, -1.5, 2147483648, true, null, '  8  '].forEach(function (v) {
  d.tabIndex = v;
  log('set tabIndex ' + show(v) + ' -> ' + show(d.getAttribute('tabindex')) + ' ' + d.tabIndex);
});
attempt('symbol tabIndex', function () { d.tabIndex = Symbol('s'); });
attempt('bigint tabIndex', function () { d.tabIndex = 1n; });
attempt('throwing valueOf', function () { d.tabIndex = { valueOf: function () { throw new Error('boom'); } }; });
d.removeAttribute('tabindex');
var a = document.createElement('a');
a.setAttribute('tabindex', 'bad');
log('invalid anchor tabIndex ' + a.tabIndex);

// enumerated: dir.
['ltr', 'RTL', 'Auto', 'bogus', '', ' ltr'].forEach(function (v) {
  d.setAttribute('dir', v);
  log('dir ' + show(v) + ' -> ' + show(d.dir));
});
d.dir = 'Bogus';
log('set dir ' + show(d.getAttribute('dir')) + ' ' + show(d.dir));
d.removeAttribute('dir');
log('missing dir ' + show(d.dir));

// boolean: presence, whatever the value.
d.setAttribute('inert', 'false');
log('inert attr false ' + d.inert);
d.inert = 0;
log('inert = 0 ' + d.hasAttribute('inert'));
d.autofocus = 'yes';
log('autofocus = yes ' + show(d.getAttribute('autofocus')));

// hidden: boolean, number or string; until-found kept.
[true, false, 'until-found', 'UNTIL-found', 'x', '', 0, 1, NaN, null, undefined, 'false'].forEach(function (v) {
  d.hidden = v;
  log('hidden = ' + show(v) + ' -> ' + show(d.getAttribute('hidden')) + ' ' + show(d.hidden));
});
d.setAttribute('hidden', 'Until-Found');
log('hidden attr Until-Found ' + show(d.hidden));
attempt('symbol hidden', function () { d.hidden = Symbol('s'); });

// translate and spellcheck inherit; draggable has per-element defaults.
var inner = document.getElementById('inner');
log('inherited ' + inner.translate + ' ' + inner.spellcheck);
inner.translate = true;
inner.spellcheck = true;
log('set ' + show(inner.getAttribute('translate')) + ' ' + show(inner.getAttribute('spellcheck')) + ' ' + inner.translate + ' ' + inner.spellcheck);
['bogus', '', 'YES', 'No', 'true'].forEach(function (v) {
  inner.setAttribute('translate', v);
  inner.setAttribute('spellcheck', v);
  log('attr ' + show(v) + ' translate=' + inner.translate + ' spellcheck=' + inner.spellcheck);
});
inner.translate = false;
inner.spellcheck = 0;
log('set false ' + show(inner.getAttribute('translate')) + ' ' + show(inner.getAttribute('spellcheck')));
var detached = document.createElement('span');
document.createElement('div').appendChild(detached).parentNode.setAttribute('translate', 'no');
log('detached parent ' + detached.translate);
log('root ' + document.documentElement.translate + ' ' + document.documentElement.spellcheck);

d.draggable = true;
log('draggable true ' + show(d.getAttribute('draggable')));
d.draggable = '';
log('draggable empty ' + show(d.getAttribute('draggable')) + ' ' + d.draggable);
d.setAttribute('draggable', 'TRUE');
log('draggable TRUE ' + d.draggable);
var img = document.createElement('img');
img.setAttribute('draggable', 'auto');
log('img draggable auto ' + img.draggable);
img.setAttribute('draggable', 'false');
log('img draggable false ' + img.draggable);
a.setAttribute('href', '');
log('a with href draggable ' + a.draggable);
"
|     "


