<script>
function log(s) {
  document.getElementById('log').appendChild(document.createTextNode(String(s) + '\n'));
}
function num(v) {
  return Object.is(v, -0) ? '-0' : String(v);
}
function val(expr, ctx) {
  try {
    var r = document.evaluate(expr, ctx || document.getElementById('t'), null, 0, null);
    var t = r.resultType;
    var v = t === 1 ? num(r.numberValue) : t === 2 ? JSON.stringify(r.stringValue) : t === 3 ? String(r.booleanValue) : 'nodes ' + r.resultType;
    log(expr + ' => ' + t + ' ' + v);
  } catch (e) {
    log(expr + ' THREW ' + e.name + ': ' + e.message);
  }
}
var exprs = [
  'count(span)', 'count(//span[@class="n"])', 'last()', 'position()',
  'local-name()', 'local-name(span)', 'local-name(/)', 'local-name(@lang)', 'name()', 'name(@lang)',
  'namespace-uri()', 'namespace-uri(@lang)', 'namespace-uri(/nothing)',
  'string()', 'string(span)', 'string(1 div 0)', 'string(-1 div 0)', 'string(0 div 0)', 'string(-0)',
