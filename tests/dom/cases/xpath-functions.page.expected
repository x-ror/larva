  'nonexistent()', 'count()', 'count(1)', 'substring("a")', '1 +', '//[', 'span[', '@', '"unterminated', '1 2', 'concat("a")', 'string(1, 2)', 'foo:bar', 'child::foo:bar', 'bogus::x', '$var',
  '', '   ', '. | 1',
];
for (var i = 0; i < exprs.length; i++) val(exprs[i]);
