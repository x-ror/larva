{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(./scripts/*:*)",
      "Bash(bash scripts/*:*)",
      "Bash(odin:*)",
      "Bash(./build_odin.sh:*)",
      "Bash(LLVM_CONFIG=llvm-config-18 ./build_odin.sh:*)",
      "Bash(llvm-config-18:*)",
      "Bash(clang-18:*)",
      "Bash(pkg-config:*)",
      "Bash(nm:*)",
      "Bash(ldd:*)",
      "Bash(apt-cache:*)",
      "Bash(./bin/lava:*)",
      "Bash(bin/lava:*)",
      "Bash(node:*)",
      "Bash(bun:*)",
      "Bash(bun install:*)",
      "Bash(npx markdownlint-cli2:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(git push origin claude/:*)",
      "Bash(taskset:*)",
      "Bash(nproc)",
      "Bash(ls /proc/self/fd:*)",
      "Bash(/usr/bin/time:*)",
      "Bash(perf stat:*)",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__get_file_contents",
      "mcp__github__list_branches",
      "mcp__github__list_commits"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard origin/master:*)",
      "Bash(rm -rf /:*)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/odin-env.mjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Reading the Odin pin and local toolchain"
          }
        ]
      }
    ]
  }
}